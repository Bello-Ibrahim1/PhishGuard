{
  "manifest_version": 3,
  "name": "PhishGuard",
  "version": "0.3",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://mail.google.com/*", "http://localhost:*/*", "https://*/*"],
  "options_ui": { "page": "options.html" },
  "content_scripts": [
    { "matches": ["https://mail.google.com/*"], "js": ["content_script.js"] }
  ],
  "web_accessible_resources": [
    { "resources": ["overlay.css", "assets/*"], "matches": ["https://mail.google.com/*"] }
  ],
  "action": { "default_popup": "popup.html", "default_title": "PhishGuard" }
}